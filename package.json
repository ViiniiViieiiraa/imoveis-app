{
    "name": "imoveis-app",
    "version": "1.0.0",
    "description": "Sistema local de gestão de imóveis",
    "main": "dist/server.js",
    "scripts": {
      "dev": "tsx watch src/server.ts",
      "build": "tsc",
      "start": "node dist/server.js",
      "db:migrate": "prisma migrate deploy",
      "db:generate": "prisma generate",
      "db:studio": "prisma studio",
      "db:seed": "tsx scripts/seed.ts",
      "setup": "npm install && prisma generate && prisma db push && npm run build",
      "db:push": "prisma db push"
    },
    "dependencies": {
      "@fastify/static": "^8.0.3",
      "@fastify/view": "^10.0.1",
      "@prisma/client": "^5.22.0",
      "dotenv": "^16.4.5",
      "fastify": "^5.2.1",
      "fastify-plugin": "^5.0.1",
      "handlebars": "^4.7.8",
      "zod": "^3.23.8"
    },
    "devDependencies": {
      "@types/node": "^22.10.1",
      "pino-pretty": "^13.0.0",
      "prisma": "^5.22.0",
      "tsx": "^4.19.2",
      "typescript": "^5.7.2"
    }
  }