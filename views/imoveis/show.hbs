
<div class="space-y-6">
  <!-- Header -->
  <div class="flex items-start justify-between">
    <div>
      <a href="/imoveis" class="text-sm text-gray-500 hover:text-gray-700">← Imóveis</a>
      <h2 class="text-xl font-bold text-gray-900 mt-1">{{imovel.nome}}</h2>
      <p class="text-gray-500 text-sm mt-0.5">
        {{imovel.endereco}}{{#if imovel.bairro}}, {{imovel.bairro}}{{/if}} — {{imovel.cidade}}/{{imovel.estado}}
      </p>
    </div>
    <div class="flex gap-2">
      <a href="/imoveis/{{imovel.id}}/editar" class="btn btn-secondary">Editar</a>
      <form method="POST" action="/imoveis/{{imovel.id}}/excluir" onsubmit="return confirm('Excluir este imóvel? Esta ação não pode ser desfeita.')">
        <button type="submit" class="btn btn-danger">Excluir</button>
      </form>
    </div>
  </div>

  <!-- Info cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="metric-card">
      <p class="metric-label">Tipo</p>
      <p class="text-base font-semibold text-gray-800 mt-1">{{statusLabel imovel.tipo}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Valor patrimonial</p>
      <p class="text-base font-semibold text-gray-800 mt-1">{{#if imovel.valor_imovel}}{{currency imovel.valor_imovel}}{{else}}—{{/if}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Total de unidades</p>
      <p class="metric-value mt-1">{{imovel.unidades.length}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Status</p>
      <p class="text-base font-semibold mt-1 text-gray-700">Ver lista abaixo</p>
    </div>
  </div>

  {{#if imovel.observacoes}}
  <div class="card">
    <p class="text-sm text-gray-500 font-medium mb-1">Observações</p>
    <p class="text-gray-700 text-sm">{{imovel.observacoes}}</p>
  </div>
  {{/if}}

  <!-- Unidades -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Unidades</h3>
      <a href="/unidades/nova?imovel_id={{imovel.id}}" class="btn btn-primary">+ Nova unidade</a>
    </div>

    {{#if imovel.unidades.length}}
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Identificação</th>
            <th>Tipo</th>
            <th>Aluguel</th>
            <th>Vencimento</th>
            <th>Status</th>
            <th>Inquilino</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each imovel.unidades}}
          <tr>
            <td><a href="/unidades/{{id}}" class="font-medium text-brand-600 hover:underline">{{identificacao}}</a></td>
            <td class="text-gray-500 capitalize">{{tipo}}</td>
            <td>{{currency valor_aluguel}}</td>
            <td class="text-gray-500">Dia {{dia_vencimento}}</td>
            <td><span class="badge {{statusClass status}}">{{statusLabel status}}</span></td>
            <td class="text-gray-500">
              {{#if contratos.[0].inquilino.nome}}{{contratos.[0].inquilino.nome}}{{else}}—{{/if}}
            </td>
            <td class="text-right">
              <a href="/unidades/{{id}}" class="btn btn-secondary btn-sm">Ver</a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty-state">
      <p>Nenhuma unidade cadastrada neste imóvel.</p>
      <a href="/unidades/nova?imovel_id={{imovel.id}}" class="btn btn-primary mt-4">Adicionar unidade</a>
    </div>
    {{/if}}
  </div>
</div>
