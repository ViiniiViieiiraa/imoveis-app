<div class="max-w-2xl">
  <div class="mb-4">
    <a href="{{#if inquilino.id}}/inquilinos/{{inquilino.id}}{{else}}/inquilinos{{/if}}" class="text-sm text-gray-500 hover:text-gray-700">← Voltar</a>
  </div>
  <div class="card">
    <div class="card-header"><h2 class="card-title">{{title}}</h2></div>
    <form method="POST" action="{{#if inquilino.id}}/inquilinos/{{inquilino.id}}{{else}}/inquilinos{{/if}}" class="space-y-5">

      <div class="form-grid">
        <div class="form-group" style="grid-column:span 2">
          <label class="form-label" for="nome">Nome completo *</label>
          <input class="form-input {{#if errors.nome}}border-red-400{{/if}}" type="text" id="nome" name="nome" value="{{inquilino.nome}}" required>
          {{#if errors.nome}}<p class="form-error">{{errors.nome}}</p>{{/if}}
        </div>
        <div class="form-group">
          <label class="form-label" for="tipo_pessoa">Tipo</label>
          <select class="form-select" id="tipo_pessoa" name="tipo_pessoa">
            <option value="fisica" {{#if (eq inquilino.tipo_pessoa 'fisica')}}selected{{/if}}>Pessoa Física</option>
            <option value="juridica" {{#if (eq inquilino.tipo_pessoa 'juridica')}}selected{{/if}}>Pessoa Jurídica</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="cpf_cnpj">CPF / CNPJ</label>
          <input class="form-input" type="text" id="cpf_cnpj" name="cpf_cnpj" value="{{inquilino.cpf_cnpj}}" placeholder="000.000.000-00">
        </div>
        <div class="form-group">
          <label class="form-label" for="telefone">Telefone</label>
          <input class="form-input" type="text" id="telefone" name="telefone" value="{{inquilino.telefone}}" placeholder="(11) 99999-9999">
        </div>
        <div class="form-group">
          <label class="form-label" for="email">E-mail</label>
          <input class="form-input {{#if errors.email}}border-red-400{{/if}}" type="email" id="email" name="email" value="{{inquilino.email}}">
          {{#if errors.email}}<p class="form-error">{{errors.email}}</p>{{/if}}
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="observacoes">Observações</label>
        <textarea class="form-textarea" id="observacoes" name="observacoes" rows="3">{{inquilino.observacoes}}</textarea>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn btn-primary">{{#if inquilino.id}}Salvar alterações{{else}}Criar inquilino{{/if}}</button>
        <a href="{{#if inquilino.id}}/inquilinos/{{inquilino.id}}{{else}}/inquilinos{{/if}}" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
