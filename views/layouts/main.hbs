<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} — Gestão de Imóveis</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#f0f4ff',
              100: '#e0e9ff',
              500: '#4f6ef7',
              600: '#3d5ce8',
              700: '#2e4bd4',
            }
          }
        }
      }
    }
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <link rel="stylesheet" href="/public/css/app.css" />
</head>
<body class="h-full" x-data="appShell()">

  <div class="flex h-full">

    <!-- Sidebar -->
    <aside
      class="fixed inset-y-0 left-0 z-50 flex flex-col bg-gray-900 transition-all duration-300"
      :class="sidebarOpen ? 'w-60' : 'w-16'"
    >
      <!-- Logo -->
      <div class="flex h-16 items-center px-4 border-b border-gray-700 shrink-0">
        <div class="flex items-center gap-3 overflow-hidden">
          <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <span
            class="text-white font-semibold text-sm whitespace-nowrap transition-opacity duration-200"
            :class="sidebarOpen ? 'opacity-100' : 'opacity-0'"
          >Gestão de Imóveis</span>
        </div>
      </div>

      <!-- Nav -->
      <nav class="flex-1 overflow-y-auto py-4 px-2 space-y-1">
        <a href="/dashboard" class="nav-link {{#if (eq activePage '/dashboard')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Dashboard</span>
        </a>
        <a href="/imoveis" class="nav-link {{#if (eq activePage '/imoveis')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Imóveis</span>
        </a>
        <a href="/unidades" class="nav-link {{#if (eq activePage '/unidades')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Unidades</span>
        </a>
        <a href="/inquilinos" class="nav-link {{#if (eq activePage '/inquilinos')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Inquilinos</span>
        </a>
        <a href="/contratos" class="nav-link {{#if (eq activePage '/contratos')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Contratos</span>
        </a>
        <a href="/pagamentos" class="nav-link {{#if (eq activePage '/pagamentos')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Pagamentos</span>
        </a>
        <a href="/despesas" class="nav-link {{#if (eq activePage '/despesas')}}active{{/if}}">
          <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/></svg>
          <span class="nav-label" :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'">Despesas</span>
        </a>
      </nav>

      <!-- Toggle -->
      <div class="p-2 border-t border-gray-700">
        <button
          @click="sidebarOpen = !sidebarOpen"
          class="w-full flex items-center justify-center h-9 rounded-lg text-gray-400 hover:bg-gray-700 hover:text-white transition-colors"
        >
          <svg class="w-5 h-5 transition-transform duration-300" :class="sidebarOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
          </svg>
        </button>
      </div>
    </aside>

    <!-- Main -->
    <div class="flex flex-col flex-1 min-h-full transition-all duration-300" :class="sidebarOpen ? 'ml-60' : 'ml-16'">

      <!-- Topbar -->
      <header class="sticky top-0 z-40 flex h-16 items-center justify-between bg-white border-b border-gray-200 px-6">
        <h1 class="text-lg font-semibold text-gray-900">{{title}}</h1>
        <div class="flex items-center gap-3">
          <!-- Alertas badge -->
          <div x-data="alertasBadge()" x-init="carregar()">
            <button
              @click="aberto = !aberto"
              class="relative flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
              <span
                x-show="criticos > 0"
                x-text="criticos"
                class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-white text-xs font-bold"
              ></span>
            </button>

            <!-- Dropdown alertas -->
            <div
              x-show="aberto"
              @click.outside="aberto = false"
              x-transition
              class="absolute right-6 top-14 w-80 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden"
            >
              <div class="px-4 py-3 border-b border-gray-100">
                <p class="text-sm font-semibold text-gray-900">Alertas</p>
              </div>
              <div class="max-h-72 overflow-y-auto divide-y divide-gray-50">
                <template x-if="alertas.length === 0">
                  <p class="px-4 py-6 text-sm text-gray-400 text-center">Nenhum alerta ativo</p>
                </template>
                <template x-for="a in alertas" :key="a.mensagem">
                  <a :href="a.link" class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 transition-colors">
                    <span
                      class="mt-0.5 w-2 h-2 rounded-full shrink-0"
                      :class="{
                        'bg-red-500': a.tipo === 'critico',
                        'bg-amber-400': a.tipo === 'atencao',
                        'bg-blue-400': a.tipo === 'info'
                      }"
                    ></span>
                    <span class="text-sm text-gray-700 leading-snug" x-text="a.mensagem"></span>
                  </a>
                </template>
              </div>
            </div>
          </div>

          <!-- Data -->
          <span class="text-sm text-gray-500" x-data x-text="new Date().toLocaleDateString('pt-BR', {weekday:'short', day:'2-digit', month:'short', year:'numeric'})"></span>
        </div>
      </header>

      <!-- Content -->
      <main class="flex-1 p-6">
        {{{body}}}
      </main>

    </div>
  </div>

  <script src="/public/js/app.js"></script>
</body>
</html>
