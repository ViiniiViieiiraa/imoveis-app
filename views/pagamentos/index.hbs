<div class="space-y-4" x-data="pagamentosPage()">

  <!-- Filtros -->
  <div class="card">
    <form method="GET" action="/pagamentos" class="flex flex-wrap items-end gap-3">
      <div class="form-group">
        <label class="form-label">Mês</label>
        <select name="mes" class="form-select" style="width:auto">
          <option value="1"  {{#if (eq mes 1)}}selected{{/if}}>Janeiro</option>
          <option value="2"  {{#if (eq mes 2)}}selected{{/if}}>Fevereiro</option>
          <option value="3"  {{#if (eq mes 3)}}selected{{/if}}>Março</option>
          <option value="4"  {{#if (eq mes 4)}}selected{{/if}}>Abril</option>
          <option value="5"  {{#if (eq mes 5)}}selected{{/if}}>Maio</option>
          <option value="6"  {{#if (eq mes 6)}}selected{{/if}}>Junho</option>
          <option value="7"  {{#if (eq mes 7)}}selected{{/if}}>Julho</option>
          <option value="8"  {{#if (eq mes 8)}}selected{{/if}}>Agosto</option>
          <option value="9"  {{#if (eq mes 9)}}selected{{/if}}>Setembro</option>
          <option value="10" {{#if (eq mes 10)}}selected{{/if}}>Outubro</option>
          <option value="11" {{#if (eq mes 11)}}selected{{/if}}>Novembro</option>
          <option value="12" {{#if (eq mes 12)}}selected{{/if}}>Dezembro</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Ano</label>
        <input class="form-input" type="number" name="ano" value="{{ano}}" style="width:90px" min="2000" max="2100">
      </div>
      <div class="form-group">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" style="width:auto">
          <option value="">Todos</option>
          <option value="pendente"  {{#if (eq filtroStatus 'pendente')}}selected{{/if}}>Pendente</option>
          <option value="pago"      {{#if (eq filtroStatus 'pago')}}selected{{/if}}>Pago</option>
          <option value="atrasado"  {{#if (eq filtroStatus 'atrasado')}}selected{{/if}}>Atrasado</option>
          <option value="parcial"   {{#if (eq filtroStatus 'parcial')}}selected{{/if}}>Parcial</option>
          <option value="isento"    {{#if (eq filtroStatus 'isento')}}selected{{/if}}>Isento</option>
        </select>
      </div>
      <button type="submit" class="btn btn-secondary">Filtrar</button>
    </form>
  </div>

  <!-- Resumo -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
    <div class="metric-card">
      <p class="metric-label">Previsto</p>
      <p class="text-base font-bold text-gray-700 mt-1">{{currency resumo.totalPrevisto}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Recebido</p>
      <p class="text-base font-bold text-green-600 mt-1">{{currency resumo.totalRecebido}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Pagos</p>
      <p class="text-base font-bold mt-1">{{resumo.qtdPago}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Pendentes</p>
      <p class="text-base font-bold mt-1 {{#if resumo.qtdPendente}}text-amber-500{{else}}text-gray-400{{/if}}">{{resumo.qtdPendente}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Atrasados</p>
      <p class="text-base font-bold mt-1 {{#if resumo.qtdAtrasado}}text-red-500{{else}}text-gray-400{{/if}}">{{resumo.qtdAtrasado}}</p>
    </div>
  </div>

  <!-- Bloco de geração (aparece sempre que há contratos sem cobrança) -->
  {{#unless (eq contratosNaoGerados 0)}}
  <div class="card border-2 border-dashed border-amber-300 bg-amber-50">
    <div class="flex items-center justify-between mb-4">
      <div>
        <p class="text-amber-700 font-semibold">{{contratosNaoGerados}} contrato(s) sem cobrança em {{mesLabel}}/{{ano}}</p>
        <p class="text-amber-600 text-sm mt-0.5">Selecione quais deseja gerar agora</p>
      </div>
    </div>

    <form method="POST" action="/pagamentos/gerar">
      <input type="hidden" name="mes" value="{{this.mes}}">
      <input type="hidden" name="ano" value="{{this.ano}}">

      <div class="flex items-center gap-3 mb-3">
        <button type="button" @click="selecionarTodos()" class="btn btn-secondary btn-sm">Selecionar todos</button>
        <button type="button" @click="deselecionarTodos()" class="btn btn-secondary btn-sm">Desmarcar todos</button>
        <span class="text-sm text-gray-500" x-text="selecionados + ' selecionado(s)'"></span>
      </div>

      <div class="divide-y divide-amber-100 mb-4 bg-white rounded-lg border border-amber-200 overflow-hidden">
        {{#each contratos}}
        {{#unless jaGerado}}
        <label class="flex items-center gap-3 py-3 px-4 cursor-pointer hover:bg-amber-50 transition-colors">
          <input type="checkbox" name="contrato_ids" value="{{id}}"
            checked
            @change="contarSelecionados()"
            class="w-4 h-4 text-brand-600 rounded">
          <div class="flex-1">
            <p class="font-medium text-gray-800">{{inquilino.nome}}</p>
            <p class="text-sm text-gray-500">{{unidade.identificacao}} — {{unidade.imovel.nome}} · Venc. dia {{unidade.dia_vencimento}}</p>
          </div>
          <span class="text-sm font-medium text-gray-700">{{currency valor_aluguel}}</span>
        </label>
        {{/unless}}
        {{/each}}
      </div>

      <div class="flex justify-end">
        <button type="submit" class="btn btn-primary"
          onclick="return confirm('Gerar cobranças para os contratos selecionados?')">
          Gerar cobranças selecionadas
        </button>
      </div>
    </form>
  </div>
  {{/unless}}

  <!-- Lista de pagamentos já gerados -->
  {{#if pagamentos.length}}
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">{{mesLabel}}/{{ano}}</h2>
      <span class="text-sm text-gray-400">{{resumo.total}} cobrança(s) gerada(s)</span>
    </div>

    <div class="divide-y divide-gray-100" id="lista-pagamentos">
      {{#each pagamentos}}
      <div class="py-3" id="pag-{{id}}">
        <div class="flex items-center gap-3 flex-wrap">

          <!-- Info -->
          <div class="flex-1 min-w-0">
            <p class="font-medium text-gray-900 truncate">{{contrato.inquilino.nome}}</p>
            <p class="text-sm text-gray-500 truncate">{{contrato.unidade.identificacao}} — {{contrato.unidade.imovel.nome}}</p>
            {{#if saldo_incorporado}}
            {{#if (neq saldo_incorporado 0)}}
            <p class="text-xs text-amber-600 mt-0.5">⚠ Inclui saldo anterior: {{currency saldo_incorporado}}</p>
            {{/if}}
            {{/if}}
          </div>

          <!-- Valor -->
          <div class="text-right shrink-0">
            <p class="font-semibold text-gray-800">{{currency valor_previsto}}</p>
            <p class="text-xs text-gray-400">Venc. {{date data_vencimento}}</p>
            {{#if (eq status 'parcial')}}
            <p class="text-xs text-blue-600">Pago: {{currency valor_pago}}</p>
            {{/if}}
          </div>

          <!-- Status -->
          <div class="shrink-0 text-right">
            <span class="badge {{statusClass status}}">{{statusLabel status}}</span>
            {{#if (eq status 'pago')}}
            <p class="text-xs text-green-600 mt-0.5">{{date data_pagamento}}</p>
            {{/if}}
          </div>

          <!-- Ações -->
          <div class="flex gap-2 shrink-0 flex-wrap">
            {{#unless (eq status 'pago')}}
            {{#unless (eq status 'isento')}}
            <button type="button"
              onclick="toggleBaixa({{id}})"
              class="btn btn-primary btn-sm"
              id="btn-baixa-{{id}}">
              Dar baixa
            </button>
            <button type="button"
              id="btn-cob-{{id}}"
              onclick="copiarCobranca({{id}})"
              class="btn btn-secondary btn-sm">
              📋 Cobrança
            </button>
            {{/unless}}
            {{/unless}}
            <button type="button"
              onclick="toggleEdit({{id}})"
              class="btn btn-secondary btn-sm"
              title="Editar">⚙</button>
          </div>
        </div>

        <!-- Formulário dar baixa -->
        <div id="baixa-{{id}}" style="display:none" class="mt-3 p-3 bg-green-50 rounded-lg border border-green-200">
          <form method="POST" action="/pagamentos/{{id}}/registrar" class="flex flex-wrap gap-3 items-end">
            <div class="form-group">
              <label class="form-label text-xs">Valor recebido (R$)</label>
              <input class="form-input" type="number" name="valor_pago"
                value="{{valor_previsto}}" step="0.01" min="0.01"
                style="width:140px" required>
            </div>
            <div class="form-group">
              <label class="form-label text-xs">Data do pagamento</label>
              <input class="form-input" type="date" name="data_pagamento"
                value="{{dateInput ../hoje}}" required>
            </div>
            <div class="form-group" style="flex:1;min-width:140px">
              <label class="form-label text-xs">Observações</label>
              <input class="form-input" type="text" name="observacoes" placeholder="Opcional">
            </div>
            <button type="submit" class="btn btn-primary btn-sm">✓ Confirmar</button>
            <button type="button" onclick="toggleBaixa({{id}})" class="btn btn-secondary btn-sm">Cancelar</button>
          </form>
        </div>

        <!-- Formulário edição -->
        <div id="edit-{{id}}" style="display:none" class="mt-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
          <form method="POST" action="/pagamentos/{{id}}/editar" class="flex flex-wrap gap-3 items-end">
            <div class="form-group">
              <label class="form-label text-xs">Status</label>
              <select class="form-select" name="status" style="width:auto">
                <option value="pendente"  {{#if (eq status 'pendente')}}selected{{/if}}>Pendente</option>
                <option value="pago"      {{#if (eq status 'pago')}}selected{{/if}}>Pago</option>
                <option value="atrasado"  {{#if (eq status 'atrasado')}}selected{{/if}}>Atrasado</option>
                <option value="parcial"   {{#if (eq status 'parcial')}}selected{{/if}}>Parcial</option>
                <option value="isento"    {{#if (eq status 'isento')}}selected{{/if}}>Isento</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label text-xs">Valor pago</label>
              <input class="form-input" type="number" name="valor_pago" value="{{valor_pago}}" step="0.01" style="width:130px">
            </div>
            <div class="form-group">
              <label class="form-label text-xs">Data pagamento</label>
              <input class="form-input" type="date" name="data_pagamento" value="{{dateInput data_pagamento}}">
            </div>
            <div class="form-group" style="flex:1;min-width:140px">
              <label class="form-label text-xs">Observações</label>
              <input class="form-input" type="text" name="observacoes" value="{{observacoes}}">
            </div>
            <button type="submit" class="btn btn-secondary btn-sm">Salvar</button>
            <button type="button" onclick="toggleEdit({{id}})" class="btn btn-secondary btn-sm">Cancelar</button>
          </form>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{else}}
  {{#if (eq contratosNaoGerados 0)}}
  <div class="card">
    <div class="empty-state">
      <p>Nenhum pagamento para este período.</p>
    </div>
  </div>
  {{/if}}
  {{/if}}

</div>

<script>
function pagamentosPage() {
  return {
    selecionados: 0,
    init() { this.contarSelecionados() },
    contarSelecionados() {
      this.selecionados = document.querySelectorAll('input[name="contrato_ids"]:checked').length
    },
    selecionarTodos() {
      document.querySelectorAll('input[name="contrato_ids"]').forEach(el => el.checked = true)
      this.contarSelecionados()
    },
    deselecionarTodos() {
      document.querySelectorAll('input[name="contrato_ids"]').forEach(el => el.checked = false)
      this.contarSelecionados()
    },
  }
}

function toggleBaixa(id) {
  const el = document.getElementById('baixa-' + id)
  const editEl = document.getElementById('edit-' + id)
  if (editEl) editEl.style.display = 'none'
  el.style.display = el.style.display === 'none' ? 'block' : 'none'
}

function toggleEdit(id) {
  const el = document.getElementById('edit-' + id)
  const baixaEl = document.getElementById('baixa-' + id)
  if (baixaEl) baixaEl.style.display = 'none'
  el.style.display = el.style.display === 'none' ? 'block' : 'none'
}

async function copiarCobranca(id) {
  const btn = document.getElementById('btn-cob-' + id)
  const textoOriginal = btn.textContent
  btn.textContent = 'Gerando...'
  btn.disabled = true
  try {
    const res = await fetch('/pagamentos/' + id + '/mensagem')
    const data = await res.json()
    if (data.mensagem) {
      await navigator.clipboard.writeText(data.mensagem)
      btn.textContent = '✓ Copiado!'
      btn.style.color = 'green'
    } else {
      btn.textContent = 'Erro'
    }
  } catch(e) {
    btn.textContent = 'Erro'
    console.error(e)
  }
  setTimeout(() => {
    btn.textContent = textoOriginal
    btn.style.color = ''
    btn.disabled = false
  }, 2500)
}
</script>
