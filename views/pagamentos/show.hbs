<div class="space-y-6 max-w-2xl">
  <div>
    <a href="/pagamentos?mes={{pagamento.mes_referencia}}&ano={{pagamento.ano_referencia}}" class="text-sm text-gray-500 hover:text-gray-700">← Pagamentos</a>
    <div class="flex items-center gap-3 mt-1">
      <h2 class="text-xl font-bold text-gray-900">Pagamento #{{pagamento.id}}</h2>
      <span class="badge {{statusClass pagamento.status}}">{{statusLabel pagamento.status}}</span>
    </div>
    <p class="text-gray-500 text-sm mt-0.5">
      <a href="/contratos/{{pagamento.contrato_id}}" class="hover:underline">Contrato #{{pagamento.contrato_id}}</a>
      — <a href="/inquilinos/{{pagamento.contrato.inquilino.id}}" class="hover:underline">{{pagamento.contrato.inquilino.nome}}</a>
      — <a href="/unidades/{{pagamento.contrato.unidade.id}}" class="hover:underline">{{pagamento.contrato.unidade.identificacao}}</a>
    </p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="metric-card">
      <p class="metric-label">Referência</p>
      <p class="text-base font-semibold mt-1">{{pagamento.mes_referencia}}/{{pagamento.ano_referencia}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Vencimento</p>
      <p class="text-base font-semibold mt-1">{{date pagamento.data_vencimento}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Valor do aluguel</p>
      <p class="text-base font-semibold mt-1">{{currency pagamento.valor_previsto}}</p>
    </div>
    {{#if pagamento.saldo_incorporado}}
    <div class="metric-card border-l-4 border-amber-400">
      <p class="metric-label">Saldo anterior incorporado</p>
      <p class="text-base font-semibold text-amber-600 mt-1">+ {{currency pagamento.saldo_incorporado}}</p>
    </div>
    {{/if}}
    <div class="metric-card">
      <p class="metric-label">Total devido</p>
      <p class="text-base font-bold mt-1">{{currency totalDevido}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Valor pago</p>
      <p class="text-base font-semibold mt-1 {{#if pagamento.valor_pago}}text-green-600{{else}}text-gray-400{{/if}}">
        {{#if pagamento.valor_pago}}{{currency pagamento.valor_pago}}{{else}}—{{/if}}
      </p>
    </div>
    {{#if saldoFaltando}}
    <div class="metric-card border-l-4 border-red-400">
      <p class="metric-label">Ainda falta</p>
      <p class="text-base font-bold text-red-600 mt-1">{{currency saldoFaltando}}</p>
    </div>
    {{/if}}
  </div>

  {{#if pagamento.observacoes}}
  <div class="card">
    <p class="text-sm text-gray-500 font-medium mb-1">Observações</p>
    <p class="text-gray-700 text-sm">{{pagamento.observacoes}}</p>
  </div>
  {{/if}}

  {{#if (neq pagamento.status 'pago')}}
  {{#if (neq pagamento.status 'isento')}}
  <div class="card border-l-4 border-brand-500">
    <h3 class="card-title mb-4">Registrar pagamento</h3>
    <form method="POST" action="/pagamentos/{{pagamento.id}}/registrar" class="flex flex-wrap gap-4 items-end">
      <div class="form-group">
        <label class="form-label">Valor recebido (R$)</label>
        <input class="form-input" type="number" name="valor_pago"
          value="{{number totalDevido}}" step="0.01" min="0.01" style="width:180px" required>
        <p class="form-hint">Total: {{currency totalDevido}}</p>
      </div>
      <div class="form-group">
        <label class="form-label">Data do pagamento</label>
        <input class="form-input" type="date" name="data_pagamento" value="{{dateInput hoje}}" required>
      </div>
      <div class="form-group" style="flex:1;min-width:180px">
        <label class="form-label">Observações</label>
        <input class="form-input" type="text" name="observacoes" placeholder="Opcional">
      </div>
      <button type="submit" class="btn btn-primary">Confirmar recebimento</button>
    </form>
  </div>
  {{/if}}
  {{/if}}

  <div class="card" x-data="{aberto: false}">
    <div class="card-header">
      <h3 class="card-title">Edição manual</h3>
      <button type="button" @click="aberto = !aberto" class="btn btn-secondary btn-sm">
        <span x-text="aberto ? 'Cancelar' : 'Editar'"></span>
      </button>
    </div>
    <div x-show="aberto" x-transition class="mt-2">
      <form method="POST" action="/pagamentos/{{pagamento.id}}/editar" class="flex flex-wrap gap-4 items-end">
        <div class="form-group">
          <label class="form-label">Status</label>
          <select class="form-select" name="status" style="width:auto">
            <option value="pendente" {{#if (eq pagamento.status 'pendente')}}selected{{/if}}>Pendente</option>
            <option value="pago"     {{#if (eq pagamento.status 'pago')}}selected{{/if}}>Pago</option>
            <option value="atrasado" {{#if (eq pagamento.status 'atrasado')}}selected{{/if}}>Atrasado</option>
            <option value="parcial"  {{#if (eq pagamento.status 'parcial')}}selected{{/if}}>Parcial</option>
            <option value="isento"   {{#if (eq pagamento.status 'isento')}}selected{{/if}}>Isento</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Valor pago</label>
          <input class="form-input" type="number" name="valor_pago" value="{{pagamento.valor_pago}}" step="0.01" style="width:150px">
        </div>
        <div class="form-group">
          <label class="form-label">Data pagamento</label>
          <input class="form-input" type="date" name="data_pagamento" value="{{dateInput pagamento.data_pagamento}}">
        </div>
        <div class="form-group" style="flex:1;min-width:180px">
          <label class="form-label">Observações</label>
          <input class="form-input" type="text" name="observacoes" value="{{pagamento.observacoes}}">
        </div>
        <button type="submit" class="btn btn-secondary">Salvar</button>
      </form>
    </div>
  </div>
</div>
