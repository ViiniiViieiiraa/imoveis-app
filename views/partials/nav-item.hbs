<a
  href="{{href}}"
  class="flex items-center gap-3 px-2 py-2 rounded-lg text-sm font-medium transition-colors overflow-hidden
    {{#if (eq active href)}}bg-brand-500 text-white{{else}}text-gray-400 hover:bg-gray-700 hover:text-white{{/if}}"
  :title="!sidebarOpen ? '{{label}}' : ''"
>
  {{> (concat "partials/icons/" icon)}}
  <span
    class="whitespace-nowrap transition-opacity duration-200"
    :class="sidebarOpen ? 'opacity-100' : 'opacity-0 w-0'"
  >{{label}}</span>
</a>
