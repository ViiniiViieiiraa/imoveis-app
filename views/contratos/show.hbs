<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-start justify-between flex-wrap gap-3">
    <div>
      <a href="/contratos" class="text-sm text-gray-500 hover:text-gray-700">← Contratos</a>
      <div class="flex items-center gap-3 mt-1">
        <h2 class="text-xl font-bold text-gray-900">Contrato #{{contrato.id}}</h2>
        <span class="badge {{statusClass contrato.status}}">{{statusLabel contrato.status}}</span>
      </div>
      <p class="text-gray-500 text-sm mt-0.5">
        <a href="/inquilinos/{{contrato.inquilino.id}}" class="hover:underline">{{contrato.inquilino.nome}}</a>
        — <a href="/unidades/{{contrato.unidade.id}}" class="hover:underline">{{contrato.unidade.identificacao}}</a>
        / <a href="/imoveis/{{contrato.unidade.imovel.id}}" class="hover:underline">{{contrato.unidade.imovel.nome}}</a>
      </p>
    </div>
    <div class="flex gap-2 flex-wrap">
      {{#if (eq contrato.status 'ativo')}}
      <a href="/contratos/{{contrato.id}}/editar" class="btn btn-secondary">Editar</a>
      <form method="POST" action="/contratos/{{contrato.id}}/encerrar"
        onsubmit="return confirm('Encerrar este contrato? A unidade voltará ao status Vaga.')">
        <button type="submit" class="btn btn-danger">Encerrar</button>
      </form>
      {{/if}}
      {{#if (eq contrato.status 'encerrado')}}
      <form method="POST" action="/contratos/{{contrato.id}}/excluir"
        onsubmit="return confirm('Excluir este contrato permanentemente?')">
        <button type="submit" class="btn btn-danger">Excluir</button>
      </form>
      {{/if}}
    </div>
  </div>

  <!-- Alertas de reajuste -->
  {{#if reajusteVencido}}
  <div class="alert alert-danger">
    <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <span>Reajuste vencido desde {{date contrato.proximo_reajuste}}. Aplique o reajuste abaixo.</span>
  </div>
  {{/if}}
  {{#if reajusteProximo}}
  <div class="alert alert-warning">
    <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <span>Reajuste previsto para {{date contrato.proximo_reajuste}} (próximos 30 dias).</span>
  </div>
  {{/if}}

  <!-- Dados financeiros -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="metric-card">
      <p class="metric-label">Aluguel vigente</p>
      <p class="metric-value text-green-600 mt-1">{{currency contrato.valor_aluguel}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Vencimento</p>
      <p class="text-base font-semibold mt-1">Dia {{contrato.dia_vencimento}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Início</p>
      <p class="text-base font-semibold mt-1">{{date contrato.data_inicio}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Término</p>
      <p class="text-base font-semibold mt-1">{{#if contrato.data_fim}}{{date contrato.data_fim}}{{else}}Indeterminado{{/if}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Último reajuste</p>
      <p class="text-base font-semibold mt-1">{{#if contrato.ultimo_reajuste}}{{date contrato.ultimo_reajuste}}{{else}}Nunca{{/if}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Próximo reajuste</p>
      <p class="text-base font-semibold mt-1 {{#if reajusteVencido}}text-red-500{{else if reajusteProximo}}text-amber-500{{/if}}">
        {{date contrato.proximo_reajuste}}
      </p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Pagamentos</p>
      <p class="text-base font-semibold mt-1">{{contrato.pagamentos.length}}</p>
    </div>
    <div class="metric-card">
      <p class="metric-label">Telefone inquilino</p>
      <p class="text-base font-semibold mt-1">{{#if contrato.inquilino.telefone}}{{contrato.inquilino.telefone}}{{else}}—{{/if}}</p>
    </div>
  </div>

  {{#if contrato.observacoes}}
  <div class="card">
    <p class="text-sm text-gray-500 font-medium mb-1">Observações</p>
    <p class="text-gray-700 text-sm">{{contrato.observacoes}}</p>
  </div>
  {{/if}}

  <!-- Aplicar reajuste -->
  {{#if (eq contrato.status 'ativo')}}
  <div class="card" x-data="{aberto: false}">
    <div class="card-header">
      <h3 class="card-title">Aplicar reajuste</h3>
      <button type="button" @click="aberto = !aberto" class="btn btn-secondary btn-sm">
        <span x-text="aberto ? 'Cancelar' : 'Reajustar aluguel'"></span>
      </button>
    </div>
    <div x-show="aberto" x-transition class="mt-2">
      <form method="POST" action="/contratos/{{contrato.id}}/reajuste" class="flex flex-wrap items-end gap-4">
        <div class="form-group">
          <label class="form-label" for="percentual">Percentual de reajuste (%)</label>
          <input class="form-input" type="number" id="percentual" name="percentual" step="0.01" min="0.01" placeholder="Ex: 5.67" style="width:180px" required>
        </div>
        <div class="form-group" style="flex:1; min-width:200px">
          <label class="form-label" for="obs_reajuste">Observações</label>
          <input class="form-input" type="text" id="obs_reajuste" name="observacoes" placeholder="Ex: IGPM 2024">
        </div>
        <div class="pb-px">
          <p class="text-sm text-gray-500 mb-1">Valor atual: <strong>{{currency contrato.valor_aluguel}}</strong></p>
          <button type="submit" class="btn btn-primary"
            onclick="return confirm('Confirmar reajuste? Esta ação não pode ser desfeita.')">
            Confirmar reajuste
          </button>
        </div>
      </form>
    </div>
  </div>
  {{/if}}

  <!-- Pagamentos -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Pagamentos</h3>
      <a href="/pagamentos?contrato_id={{contrato.id}}" class="text-sm text-brand-500 hover:underline">Ver todos</a>
    </div>
    {{#if contrato.pagamentos.length}}
    <div class="table-wrapper">
      <table>
        <thead>
          <tr><th>Referência</th><th>Vencimento</th><th>Valor previsto</th><th>Valor pago</th><th>Pagamento</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          {{#each contrato.pagamentos}}
          <tr>
            <td class="font-medium">{{mes_referencia}}/{{ano_referencia}}</td>
            <td class="text-gray-500">{{date data_vencimento}}</td>
            <td>{{currency valor_previsto}}</td>
            <td>{{#if valor_pago}}{{currency valor_pago}}{{else}}—{{/if}}</td>
            <td class="text-gray-500">{{#if data_pagamento}}{{date data_pagamento}}{{else}}—{{/if}}</td>
            <td><span class="badge {{statusClass status}}">{{statusLabel status}}</span></td>
            <td class="text-right"><a href="/pagamentos/{{id}}" class="btn btn-secondary btn-sm">Ver</a></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty-state"><p>Nenhum pagamento gerado.</p><a href="/pagamentos" class="btn btn-secondary mt-3">Ir para pagamentos</a></div>
    {{/if}}
  </div>

  <!-- Histórico de reajustes -->
  {{#if contrato.historico_reajustes.length}}
  <div class="card">
    <div class="card-header"><h3 class="card-title">Histórico de reajustes</h3></div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>Data</th><th>Valor anterior</th><th>Valor novo</th><th>Percentual</th><th>Observações</th></tr></thead>
        <tbody>
          {{#each contrato.historico_reajustes}}
          <tr>
            <td>{{date data_reajuste}}</td>
            <td class="text-gray-500">{{currency valor_anterior}}</td>
            <td class="text-green-600 font-medium">{{currency valor_novo}}</td>
            <td class="text-brand-600">+{{number percentual}}%</td>
            <td class="text-gray-500">{{#if observacoes}}{{observacoes}}{{else}}—{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/if}}

</div>
